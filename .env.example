# Copy to .env and fill in. Never commit real secrets.
FRAPPE_URL=http://127.0.0.1:8080
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_P1_APP=ACC-LOAP-2026-00001

# Required by the chat API: HMAC key for session tokens. Generate one with `openssl rand -hex 32`.
# The server refuses to start without it. Local demos only: pass --dev-ephemeral-secret instead (random key,
# tokens die on restart, warning on stderr).
AGENT_SESSION_SECRET=

# Active LLM provider: groq | omniroute (default). The model ID must be set explicitly; nothing
# is assumed about what the account may call. No local vLLM/llama.cpp server is used.
#   groq       base https://api.groq.com/openai/v1   key GROQ_API_KEY
#   omniroute  base http://127.0.0.1:20128/v1        key OMNIROUTE_API_KEY (only if the gateway requires one)
LLM_PROVIDER=omniroute
LLM_MODEL=
GROQ_API_KEY=
OMNIROUTE_API_KEY=

# Optional overrides, highest precedence first: explicit code argument > LLM_BASE > OMNIROUTE_BASE_URL
# > provider default. LLM_API_KEY is a generic bearer token and wins over the provider key.
# LLM_BASE=
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# LLM_API_KEY=
# LLM_REASONING_EFFORT=low   # set empty to omit the parameter for gateways that reject it
# LLM_STREAM_USAGE=1         # set 0 to omit stream_options.include_usage
# LLM_TIMEOUT_S=120
# LLM_RETRIES=3

# Self-hosted Langfuse tracing (optional). Start the local stack in infra/langfuse, then copy the
# LANGFUSE_* lines from infra/langfuse/.env. Leave LANGFUSE_ENABLED=0 to run with no telemetry.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_ENVIRONMENT=local
LANGFUSE_CAPTURE_CONTENT=0
# LANGFUSE_ALLOW_REMOTE=1   # only for a non-loopback self-hosted endpoint; Langfuse Cloud is always refused
