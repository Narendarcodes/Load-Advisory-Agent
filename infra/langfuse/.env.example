# Copy to .env and fill in. Never commit real secrets.
# Generate a complete local file with: python infra/langfuse/generate_env.py
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:CHANGE_ME@postgres:5432/langfuse

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

REDIS_AUTH=

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=

# First-start bootstrap (ignored once the database exists).
LANGFUSE_INIT_ORG_ID=loan-advisory
LANGFUSE_INIT_ORG_NAME="Load Advisory Agent (local)"
LANGFUSE_INIT_PROJECT_ID=loan-advisory-local
LANGFUSE_INIT_PROJECT_NAME=loan-advisory-local
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_INIT_USER_EMAIL=admin@loan-advisory.local
LANGFUSE_INIT_USER_NAME="Local Admin"
LANGFUSE_INIT_USER_PASSWORD=
