# The assistant island build is generated by `npm run build` in apps/web/assistant and is committed
# on purpose: the Frappe container has no Node, so this directory is what the portal actually serves.
# Store it byte-exact (-text), keep it out of the whitespace heuristic that is meant for hand-written
# code (-whitespace), and collapse it in GitHub diffs (linguist-generated).
apps/loan_advisory_portal/loan_advisory_portal/public/js/assistant/** -whitespace -text linguist-generated=true

# Vendored webfonts and their SIL Open Font License texts. Third-party files: stored byte-exact and
# never run through the whitespace heuristic, because editing a license file is not an option.
apps/loan_advisory_portal/loan_advisory_portal/public/fonts/** -whitespace -text linguist-generated=true

# Acceptance evidence is captured machine output (axe results, probe transcripts, keyboard walks).
# It is quoted, not authored, so the whitespace heuristic does not apply to it.
docs/borrower-frontend/acceptance/** -whitespace -text linguist-generated=true
