{
  "name": "@loan-advisory/copilot-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin CopilotKit Runtime gateway to the FastAPI AG-UI endpoint",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/runtime": "1.83.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
