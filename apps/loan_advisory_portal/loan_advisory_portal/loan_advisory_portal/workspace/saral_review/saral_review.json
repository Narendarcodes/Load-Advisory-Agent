 "content": "[{\"id\": \"saral-h\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Saral Review</b></span>\", \"col\": 12}}, {\"id\": \"saral-p\", \"type\": \"paragraph\", \"data\": {\"text\": \"Applications the rules sent to manual review, newest first. Open one, read the frozen Decision Snapshot and its internal reasons, then use <b>Review</b> \\u2192 Approve, Decline or Request info. Every action needs a note and is kept in the audit table.\", \"col\": 12}}, {\"id\": \"saral-s1\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Manual Review Queue\", \"col\": 4}}, {\"id\": \"saral-s2\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Decision Snapshots\", \"col\": 4}}, {\"id\": \"saral-s3\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"All Loan Applications\", \"col\": 4}}, {\"id\": \"saral-q\", \"type\": \"quick_list\", \"data\": {\"quick_list_name\": \"In manual review (newest first)\", \"col\": 12}}, {\"id\": \"saral-c1\", \"type\": \"card\", \"data\": {\"card_name\": \"Decision records\", \"col\": 4}}, {\"id\": \"saral-c2\", \"type\": \"card\", \"data\": {\"card_name\": \"Applicant evidence\", \"col\": 4}}, {\"id\": \"saral-c3\", \"type\": \"card\", \"data\": {\"card_name\": \"Consent and lists\", \"col\": 4}}]",
