   "licence": "CC BY 4.0",
   "provenance": "Synthetic fake-Aadhaar-app cards (Javeriya & Makandar 2024, DOI 10.17632/wk6n8fhx3c.1); fictitious names/numbers; front, contrast_adjusted variant. Labels hand-written from the image."
  },
  "wm_pvc": {
