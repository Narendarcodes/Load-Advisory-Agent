  },
  "agami": {
   "url": "https://huggingface.co/datasets/AgamiAI/Indian-Bank-Statements",
   "licence": "Apache-2.0",
   "provenance": "Fully synthetic Indian business bank statements, scanned PDFs + JSON ground truth (page 1 used)."
  },
  "bsc": {
