  "wm_aadhaar_neg": {
   "url": "https://commons.wikimedia.org/wiki/File:A_sample_of_Aadhaar_card.jpg ; https://commons.wikimedia.org/wiki/File:Specimen_of_an_Aadhaar_Card_2024.png",
